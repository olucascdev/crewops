{
  "name": "crewops",
  "private": true,
  "version": "0.1.0",
  "description": "CrewOps field operations platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm --workspace @crewops/db run generate",
    "db:migrate": "npm --workspace @crewops/db run migrate"
  },
  "engines": {
    "node": ">=20.11"
  }
}
