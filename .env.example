# ---------------------------------------------------------------------------
# CrewOps — environment template. Copy to `.env` (root) for local development.
# No real secrets live here: every value is a development placeholder.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=4000

# --- Web (public at build/runtime; required by apps/web) ---
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- PostgreSQL + PostGIS (source of truth) ---
# Host and port match docker-compose `postgres` service for local development.
DATABASE_URL=postgres://crewops:crewops@localhost:5432/crewops
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Redis (queues, cache, realtime fan-out) ---
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=crewops

# --- Auth (placeholder only; real secret must never be committed) ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=86400

# --- S3 / Cloudflare R2 (D-101 PENDING — placeholders, no real credentials) ---
# This section is intentionally empty until the S3/R2 decision is approved.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- WebSocket gateway ---
WS_PORT=

# --- Test isolation (CI/local; never used by the running app) ---
TEST_DATABASE_URL=postgres://crewops:crewops@localhost:5432/crewops_test
TEST_REDIS_URL=redis://localhost:6379/1
