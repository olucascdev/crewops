# ---------------------------------------------------------------------------
# CrewOps — environment template. Copy to `.env` (root) for local development:
#
#   cp .env.example .env
#
# Every value here is a development placeholder. No real secrets live in this
# file. Never commit a value containing a production/real credential.
#
# Legend
#   required    the app fails fast at boot/build/start if this variable is absent
#   optional    a sensible default is applied when the variable is omitted
#   [type]      the expected/parsed shape (URL, boolean, number, enum, CSV)
# ---------------------------------------------------------------------------

# --- App (shared by API and web) ---

# [enum: development | test | production] optional — defaults to "development"
NODE_ENV=development

# --- API (apps/api) ---

# [number] optional — HTTP listen port. Defaults to 4000.
PORT=4000

# [CSV of URLs] optional — allowed CORS origins, comma-separated.
WEB_ORIGIN=http://localhost:3000

# --- Web (apps/web) — public at build/runtime ---

# [URL] required — base URL of the API the PWA talks to. Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# [URL] required — base URL of the realtime WebSocket endpoint (API/gateway).
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- PostgreSQL + PostGIS (source of truth) ---

# [URL] required — DSN used by API, drizzle, seed and rollback.
# Host/port match the docker-compose `postgres` service for local development.
DATABASE_URL=postgres://crewops:crewops@localhost:5432/crewops

# [boolean] optional — use TLS for the connection. Defaults to false.
DATABASE_SSL=false

# [number] optional — PostgreSQL pool size. Defaults to 10.
DATABASE_POOL_MAX=10

# --- Redis (queues, cache, realtime fan-out) ---

# [URL] required — DSN used by API (health, realtime, future queues).
REDIS_URL=redis://localhost:6379

# [string] optional — key prefix for all Redis keys. Defaults to "crewops".
REDIS_PREFIX=crewops

# --- Auth (placeholder only; real secret must never be committed) ---

# [string] required — HS256 sign/verify secret. MUST be replaced in any non-dev
# environment. Never commit a production value.
JWT_SECRET=change-me

# [number] optional — JWT lifetime in seconds. Defaults to 86400.
JWT_EXPIRES_IN=86400

# --- S3 / Cloudflare R2 (dev-only placeholders; no real credentials) ---
# D-101 decision is still PENDING; these values are non-functional local
# placeholders for object storage (MinIO-compatible endpoint). Replace them
# with real credentials only in a private environment, never here.

# [URL] optional — object-storage endpoint. Local MinIO/R2-compatible.
S3_ENDPOINT=http://localhost:9000

# [string] optional — storage region. "auto" for Cloudflare R2 / MinIO.
S3_REGION=auto

# [string] optional — bucket used by evidence uploads (dev).
S3_BUCKET=crewops-evidence-dev

# [string] optional — dev-only placeholder access key.
S3_ACCESS_KEY_ID=dev-access-key

# [string] optional — dev-only placeholder secret key.
S3_SECRET_ACCESS_KEY=dev-secret-key

# [boolean] optional — force path-style addressing (MinIO/local). Defaults true.
S3_FORCE_PATH_STYLE=true

# --- WebSocket gateway ---

# [number] optional — dedicated gateway listen port when it is not shared with
# the API. Leave empty to reuse the API port (NEXT_PUBLIC_WS_URL).
WS_PORT=

# --- Test isolation (CI/local; never used by the running app) ---

# [URL] required for `test:integration` — isolated test database. The runner
# creates/drops `crewops_test` and never touches `crewops`.
TEST_DATABASE_URL=postgres://crewops:crewops@localhost:5432/crewops_test

# [URL] required for `test:integration` — isolated Redis logical database 1.
TEST_REDIS_URL=redis://localhost:6379/1
